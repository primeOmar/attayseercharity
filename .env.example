# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.

# Paystack secret key — Dashboard → Settings → API Keys & Webhooks.
# sk_test_… = sandbox (no real money); swap for sk_live_… to go live.
# Server-only: never prefix with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL (used for canonical links and the Paystack return URL).
NEXT_PUBLIC_SITE_URL=https://www.attayseer.org
# Optional: force the Paystack return URL origin (e.g. http://localhost:3000).
# SITE_URL=http://localhost:3000
